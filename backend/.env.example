# Copiar este archivo a .env y completar los valores.
# El .env no se sube al repo, este si: sirve de plantilla.

# URL de la API de Xubio. Es la unica variable con valor por defecto razonable.
API_XUBIO_URL=https://api.xubio.com

# Credenciales de la API de Xubio. Son obligatorias solo para usar
# /api/xubio/cruzar-datos. Si faltan, el endpoint responde 503
# XubioNoConfigurado y no hace ninguna llamada: no inventa movimientos.
XUBIO_CLIENT_ID=
XUBIO_CLIENT_SECRET=

# Opcionales, los valores de abajo son los que usa la app si no se definen.

# El frontend corre en el puerto 4200. Hay que habilitar las dos formas de
# escribirlo, porque el navegador distingue http://localhost:4200 de
# http://127.0.0.1:4200 y son dos origenes distintos.
# CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# El frontend llama a http://127.0.0.1:8000 de forma directa, sin proxy,
# asi que el backend tiene que escuchar ahi.
# PUERTO=8000