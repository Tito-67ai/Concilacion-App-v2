# Copiar este archivo a .env y completar los valores.
# El .env no se sube al repo, este si: sirve de plantilla.

# URL de la API de Xubio. Es la unica variable con valor por defecto razonable.
API_XUBIO_URL=https://api.xubio.com

# Credenciales de la API de Xubio. Son obligatorias solo para usar
# /api/xubio/cruzar-datos. Si faltan, el endpoint responde 503
# XubioNoConfigurado y no hace ninguna llamada: no inventa movimientos.
XUBIO_CLIENT_ID=
XUBIO_CLIENT_SECRET=

# API interna del frontend web de Xubio, para leer la lista de afiliados
# (core.xubio.com/ar/sba/api/cliente/clientes/findAllPaginado). NO es la API
# oficial: no usa client_id/secret, autentica con la cookie de sesion del
# navegador o con el token Authorization Bearer de esa misma web. Copiar el
# header Cookie o el header Authorization de una peticion de la web de Xubio
# (pestana Network -> Copy as cURL) y pegarlo aca, en el .env local. Estas
# variables no se versionan. Sin ninguna de las dos, /api/xubio/afiliados y
# /api/xubio/cruzar-afiliados responden 503 sin hacer ninguna llamada.
XUBIO_WEB_URL=https://core.xubio.com
XUBIO_WEB_COOKIE=
XUBIO_WEB_TOKEN=

# Credenciales del bot scripts/obtener_sesion_xubio.py, que renueva la sesion
# de la web de Xubio (el login vive en el SSO de Visma). Si faltan, el bot no
# tiene con que loguearse: hay que pasarle --email / --password. El login de la
# pantalla de conciliacion (POST /api/xubio/login) tambien las guarda aca, asi
# que tambien la usa el server... No se versionan y no las usa la API de
# afiliados: el server solo lee XUBIO_WEB_COOKIE o XUBIO_WEB_TOKEN de arriba.
XUBIO_EMAIL=
XUBIO_PASSWORD=

# Opcionales, los valores de abajo son los que usa la app si no se definen.

# Como abre el navegador el bot al renovar la sesion desde el login de la
# pantalla. False (por defecto) = visible, para poder completar a mano captcha
# o verificacion de Visma; True = invisible, para un server sin nadie mirando.
# XUBIO_BOT_HEADLESS=False

# El frontend corre en el puerto 4200. Hay que habilitar las dos formas de
# escribirlo, porque el navegador distingue http://localhost:4200 de
# http://127.0.0.1:4200 y son dos origenes distintos.
# CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# El frontend llama a http://127.0.0.1:8000 de forma directa, sin proxy,
# asi que el backend tiene que escuchar ahi.
# PUERTO=8000